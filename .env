COMPOSE_PROJECT_NAME=docker-media-stack

TZ=Europe/Berlin
PUID=1000
PGID=1000

DATA_ROOT=/opt/docker/data
MEDIA_ROOT=/mnt/internxt

JELLYFIN_IMAGE=jellyfin/jellyfin:latest
JELLYFIN_INTERNAL_PORT=8096
JELLYFIN_PROXY_PORT=80

TDARR_IMAGE=ghcr.io/haveagitgat/tdarr:latest
TDARR_WEB_PORT=8265
TDARR_SERVER_PORT=8266
TDARR_PROXY_PORT=80
TDARR_NODE_NAME=debian-matrix-internal
TDARR_API_KEY=HIER_TDARR_API_KEY_EINTRAGEN

PORTAINER_IMAGE=portainer/portainer-ce:lts
PORTAINER_INTERNAL_PORT=9443
PORTAINER_PROXY_PORT=80

CADDY_IMAGE=caddy:2-alpine

EPG_IMAGE=ghcr.io/iptv-org/epg:master
EPG_CRON=30 2 * * *
EPG_ARTE_CRON=30 3 * * *
EPG_DAYS=7
EPG_MAX_CONNECTIONS=1
EPG_NODE_MEMORY=512

CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
CLOUDFLARE_TUNNEL_TOKEN=HIER_CLOUDFLARE_TOKEN_EINTRAGEN
CLOUDFLARE_SSH_TUNNEL_TOKEN=HIER_CLOUDFLARE_SSH_TOKEN_EINTRAGEN

DOCKER_MEDIA_NETWORK=docker-media-net
